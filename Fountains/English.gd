DemoThanksSign = [
	"[center]Thanks for playing the demo of [color=#77FFFF]FOUNTAINS[/color]!\n\nYou've now beaten both the demo bosses, but there's still a lot to explore.[/center]", 
	"[center]If you've enjoyed the [color=#77FFFF]FOUNTAINS[/color] demo, please consider supporting the development of a full version!\nYou can find a link to the game's [color=#1d9bf0]TWITTER[/color] in the main menu.[/center]"
], 

KrusStatueSign = [
	"[center]\nGENERAL KRUS\n\n355 -       [/center]"
], 

HoPSign1 = [
	"[center]\nAt the beginning of time, there was\nOne Kingdom of Mankind, surrounded on all sides by hostile lands and strange beings.[/center]"
], 

HoPSign2 = [
	"[center]Humanity came across the [color=#77FFFF]Fountain of Youth,[/color] thought either to be a gift from the gods, or a curse. Inscribed upon it was a warning:\n[color=#77FFFF]He who drinks from the Fountain of Youth is doomed never to change.[/color][/center]"
], 

HoPSign3 = [
	"[center]Some did not heed the warning. Upon drinking, these new [color=#77FFFF]Ageless[/color] gained power beyond imagining. They became tyrannical, and brought chaos to the One Kingdom.[/center]"
], 

HoPSign4 = [
	"[center]\n[color=#fffab3]The Righteous Guard[/color] was founded from the remains of the One Kingdom, who bravely banished the [color=#77FFFF]Ageless[/color] and their followers.[/center]"
], 

HoPSign5 = [
	"[center][color=#77FFFF]The Fountain[/color] was hidden away.\nNonetheless, it is fated that the malevolent [color=#ff4c42]Usurper[/color] shall slay each [color=#77FFFF]Ageless[/color] and unearth it once more.[/center]"
], 

FishShopSign = ["[center]\nFregrind's Fishing Shop\nThis way[/center]"], 

KholoChurchSign1 = [
	"\n[center]May [color=#8a8eff]He[/color] forever restrain [color=#8aff92]Vela's[/color] influence from our homeland[/center]"
], 

KholoChurchSign2 = [
	"\n[center]Praise [color=#8a8eff]Kholo, god of the Soul[/color]; he who granted Free Will to Humanity[/center]"
], 

ChurchWarningSign = ["\n[center]DANGER\nOvergrown church[/center]"], 
BetaTestHQSign = ["\n[center]Beta Test Headquarters\n\nDANGER: May contain non-canon content![/center]"], 
BetaTestExplanationSign = [
	"Welcome to the first beta test of [color=#77FFFF]FOUNTAINS![/color]", 
	"If you don't know how to play, please download the FOUNTAINS demo and play the tutorial there.", 
	"The primary purpose of this beta test is to test the game's [color=#77FFFF]Player Message System.[/color]", 
	"Please place a lot of messages for your fellow beta testers. You can leave messages using the 'pause' menu.", 
	"The beta test ends once you kill the boss of The Veil.", 
	"If you want to be especially helpful, you can record your gameplay and email the video to fountainsgame@gmail.com.", 
	"Recording your gameplay is the best way to help me improve the game.", 
	"Finally, feel free to post screenshots or recordings of the beta test wherever you want. Also, I can't stop you from sending the game to other people, so I guess you can do that too.", 
	"Thanks for helping make [color=#77FFFF]FOUNTAINS[/color] a better game! Enjoy the beta test!"
], 
DBBetaDirections = [
